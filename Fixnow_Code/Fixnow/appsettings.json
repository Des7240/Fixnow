{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_PRODUCTION_CONNECTION_STRING_HERE"
  },
  "Jwt": {
    "SecretKey": "YOUR_SECURE_PRODUCTION_SECRET_KEY_HERE",
    "Issuer": "fixnow-api",
    "Audience": "fixnow-client",
    "AccessTokenExpiryMinutes": "60",
    "RefreshTokenExpiryDays": "7"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "App": {
    "ApiBaseUrl": "http://localhost:8080",
    "FrontendUrl": "http://localhost:5173"
  },
  "VNPay": {
    "TmnCode": "YOUR_VNPAY_TMN_CODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "FixNow Support",
    "SenderEmail": "YOUR_SENDER_EMAIL",
    "AppPassword": "YOUR_APP_PASSWORD"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  }
}
